<Window x:Class="ElkaVoicePlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/ElkaVoicePlay.ico" Title="Elka VoicePlay" Style="{StaticResource {x:Type Window}}" Width="920" Height="940" MinWidth="700" MinHeight="650"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
  <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="28,14,28,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="GameProfilesButton" Click="OnGameProfiles" Content="Game profiles" IsEnabled="False" Margin="0,0,8,0" /><Button x:Name="TranscribeAudioButton" Content="Transcribe audio" Click="OnTranscribeAudio" Margin="0,0,8,0" /><Button x:Name="DownloadsButton" Content="Downloads" Click="OnDownloads" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Image Source="Assets/ElkaVoicePlay.png" Width="50" Height="58" Margin="0,0,12,0" VerticalAlignment="Top" /><StackPanel><TextBlock Text="ELKA" Foreground="#69C7B2" FontSize="12" FontWeight="Bold" /><TextBlock Text="VoicePlay" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="Hands-free chat for games" FontSize="12" Opacity="0.7" /></StackPanel></StackPanel>
      </DockPanel>
    <Grid>
  <ScrollViewer x:Name="GamePage" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,0,28,10">

      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel><TextBlock x:Name="StateLabel" Text="Starting" FontSize="20" FontWeight="SemiBold" /><CheckBox x:Name="EnabledCheck" Content="Enabled" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnEnabledChanged" /></DockPanel>
          <TextBlock x:Name="StatusLabel" Text="Preparing local speech recognition…" Foreground="#AAB9CB" Margin="0,6,0,10" />
          <ProgressBar x:Name="LevelMeter" Minimum="0" Maximum="1" Height="5" Background="#0D141D" Foreground="#69C7B2" BorderThickness="0" />
          <TextBlock Text="Input level · active only while recording" FontSize="11" Foreground="#7F93AA" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
      <StackPanel x:Name="SettingsPanel">
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Profile" Foreground="#AAB9CB" Margin="0,0,0,6" />
            <DockPanel>
              <Button Content="Delete" DockPanel.Dock="Right" Click="OnDeleteProfile" Margin="8,0,0,0" />
              <Button Content="New" DockPanel.Dock="Right" Click="OnNewProfile" Margin="8,0,0,0" />
              <Button Content="Edit / Learn" DockPanel.Dock="Right" Click="OnEditProfile" Margin="8,0,0,0" />
              <ComboBox x:Name="ProfileBox" SelectionChanged="OnProfileSelected" />
            </DockPanel>
            <CheckBox x:Name="AutomaticProfilesCheck" Content="Allow automatic profile selection by linked EXE" Click="OnAutomaticProfiles" />
            <TextBlock x:Name="ActiveProfileLabel" Text="Target checked only when text is ready to send." FontSize="12" Foreground="#69C7B2" />
          </StackPanel>
        </Border>
        <TextBlock Text="Microphone" Foreground="#AAB9CB" Margin="0,0,0,6" />
        <DockPanel Margin="0,0,0,10"><Button Content="Refresh" Click="OnRefreshDevices" DockPanel.Dock="Right" Margin="8,0,0,0" /><ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" /></DockPanel>
        <TextBlock Text="Game speech model · all profiles · CPU" Foreground="#AAB9CB" Margin="0,0,0,6" />
        <DockPanel Margin="0,0,0,5"><Button Content="Browse…" Click="OnBrowseModel" DockPanel.Dock="Right" Margin="8,0,0,0" /><Button x:Name="LoadGameModelButton" Content="Load" Click="OnLoadModel" DockPanel.Dock="Right" Margin="8,0,0,0" /><ComboBox x:Name="GameModelBox" SelectionChanged="OnGameModelSelected" /></DockPanel>
        <TextBox x:Name="ModelPathBox" Visibility="Collapsed" ToolTip="Path to an installed whisper.cpp ggml model" />
        <TextBlock x:Name="ModelLabel" Text="Base is fastest. Medium and Large-v3 are optional downloads. Game and transcript choices are independent." FontSize="12" Foreground="#7F93AA" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Language" Foreground="#AAB9CB" Margin="0,0,0,6" /><ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Selected profile's talk button" Foreground="#AAB9CB" Margin="0,0,0,6" /><TextBlock x:Name="TriggerLabel" Text="F9" Padding="10,8" /></StackPanel>
        </Grid>
        <Expander Header="Options" Foreground="#D6E0EC" Margin="0,0,0,10">
          <StackPanel Margin="6,8,0,0">
            <CheckBox x:Name="TrayCheck" Content="Keep running in the tray when this window closes" />
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Recording limit (seconds)" /><TextBox x:Name="MaxSecondsBox" Margin="0,6,0,0" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Message limit (characters)" /><TextBox x:Name="MaxLengthBox" Margin="0,6,0,0" /></StackPanel>
            </Grid>
          </StackPanel>
        </Expander>
        <Button Content="Apply settings" HorizontalAlignment="Right" Click="OnApplySettings" Margin="0,0,0,10" />
      </StackPanel>
      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock x:Name="InstructionsLabel" Text="Open a Notepad document. Hold F9, speak, then release." FontWeight="SemiBold" />
          <TextBlock Text="The destination is checked after transcription. No valid target means a warning and no delivery. Keep the target active during delivery. Esc cancels (unless it is your talk button)." Foreground="#91A4BA" FontSize="12" Margin="0,6,0,12" />
          <WrapPanel>
            <Button x:Name="PreviewButton" Content="Hold to test transcription" Background="#287968" Margin="0,0,10,8" PreviewMouseLeftButtonDown="OnPreviewDown" PreviewMouseLeftButtonUp="OnPreviewUp" LostMouseCapture="OnPreviewLostCapture" />
            <Button x:Name="TestInputButton" Content="Test Notepad input" Click="OnTestInput" Margin="0,0,10,8" ToolTip="After a 10-second countdown, insert a fixed sample into the focused Notepad document without recording audio." />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,0,10,8" IsEnabled="False" />
            <Button Content="Test chat sequence locally" Click="OnTestChat" Margin="0,0,0,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="Last recognized message" Foreground="#AAB9CB" Margin="0,0,0,6" />
      <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
      <TextBlock x:Name="VersionLabel" Text="ElkaSoft · speech stays on this computer" Foreground="#6F839B" FontSize="11" Margin="0,10,0,0" />
    </StackPanel>
  </ScrollViewer>
      <ContentControl x:Name="TranscriptHost" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</Window>
